\centering
\footnotesize
\renewcommand{\arraystretch}{1.2}
\begin{tabular}{|p{2.2cm}|p{2.8cm}|p{4.4cm}|p{4.6cm}|}
\hline
\textbf{Category} & \textbf{Authors} & \textbf{Strengths} & \textbf{Limitations} \\ \hline
\multirow{3}{2.2cm}{ASR architectures}
& Radford et al. (2023) \cite{radford2023robust}
& Broad multilingual coverage; robust to accents; zero-shot use.
& Benchmarked on curated data; hallucination-prone decoder; one language decision per segment. \\ \cline{2-4}
& Baevski et al. (2020) \cite{baevski2020wav2vec}
