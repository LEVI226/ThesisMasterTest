# .env.example — Modèle de configuration (à copier en `.env`, ne jamais committer le vrai .env)
# Sur le Mac :  cp .env.example .env   puis remplir les valeurs marquées <...>

# === LLM (Phase 1 : Ollama local) ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === LLM (Phase 2 : Azure OpenAI — décommenter pour migrer) ===
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=<votre_cle>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# === STT (Phase 1 : Whisper local) ===
WHISPER_MODEL=small
# Token Hugging Face (diarisation pyannote). Récupérez-le sur https://huggingface.co/settings/tokens
HF_TOKEN=<votre_token_huggingface>
# Options modèle Whisper : tiny, base, small, medium, large

# === STT (Phase 2 : Azure Speech — décommenter pour migrer) ===
# AZURE_SPEECH_KEY=<votre_cle>
# AZURE_SPEECH_REGION=westeurope

# === OCR ===
# Sur Mac, Tesseract s'installe avec : brew install tesseract tesseract-lang
# Une fois installé via brew, laissez TESSERACT_PATH vide (il est dans le PATH).
TESSERACT_PATH=
TESSERACT_LANGS=fra+eng+deu

# === Storage ===
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma_db

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
